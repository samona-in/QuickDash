# Samona website — environment variables
# Copy this file to `.env.local` and fill in real values. Get them from
# Supabase → Project Settings → API (and "Connect → Frameworks" for the
# Postgres strings).

# Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=https://<your-project-ref>.supabase.co

# Supabase ANON (publishable) key — NOT the service_role key.
# The waitlist only ever inserts public rows gated by an RLS policy
# (see supabase/waitlist.sql).
SUPABASE_ANON_KEY=<your-anon-key>

# Used only by `npm run db:ensure` (runs automatically after `npm install`)
# to create the waitlist table if it does not exist. Any Postgres connection
# string with schema privileges works — the Vercel/Supabase integration
# provides these.
POSTGRES_URL_NON_POOLING=postgres://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
POSTGRES_URL=postgres://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require